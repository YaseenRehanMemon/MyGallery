# Required Environment Variables for Vercel Deployment

# 🔐 Authentication
GALLERY_USERNAME=admin
GALLERY_PASSWORD=password123
JWT_SECRET=your-secret-key-123-very-long-and-random-generate-a-new-onegit commit -m "first commit"

# 📦 Oracle MinIO Cloud Storage
S3_ENDPOINT=http://80.225.203.16:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_BUCKET=mygallery
S3_REGION=us-east-1
S3_PUBLIC_URL=http://80.225.203.16:9000

# ☁️ Vercel Blob (Optional Fallback)
# BLOB_READ_WRITE_TOKEN=
